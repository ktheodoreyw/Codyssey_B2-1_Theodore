{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "budget_app: add (대화형)",
      "type": "debugpy",
      "request": "launch",
      "module": "budget_app",
      "args": ["add"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "LEDGER_DEBUG": "1" }
    },
    {
      "name": "budget_app: 임의 명령 입력",
      "type": "debugpy",
      "request": "launch",
      "module": "budget_app",
      "args": "${input:appArgs}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "LEDGER_DEBUG": "1" }
    }
  ],
  "inputs": [
    { "id": "appArgs", "type": "promptString", "description": "예: list -limit 5", "default": "list" }
  ]
}
